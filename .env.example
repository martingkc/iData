# LLM
OPENAI_API_KEY=
MISTRAL_API_KEY=
CONTEXT_SUMMARIZATION_MODEL=gemma-4
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# MongoDB
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_NAME=FILE_BUCKET
MONGODB_COLLECTION_NAME=UNSTRUCTURED_COLLECTION
MONGODB_ADDRESS=idata-mongodb
MONGODB_PORT=27017
MONGODB_CONNECTION_STRING=mongodb://<username>:<password>@mongodb:27017
MONGO_INITDB_DATABASE=mongodb

# Milvus
MILVUS_HOST=milvus-standalone
MILVUS_PORT=19530

# PostgreSQL
POSTGRES_DB=app_db
POSTGRES_USER=
POSTGRES_PASSWORD=
SQL_AGENTDB_URI=postgres://<user>:<password>@postgres:5432/app_db

# pgAdmin
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_LISTEN_ADDRESS=[::]
PGADMIN_LISTEN_PORT=80

# Agent backend
SECRET_KEY=

# Document collector
CONFIG_FILE_RELATIVE_PATH=config.toml
CONFIGS_FOLDER_PATH=/app/configs/
LOCAL_DOCUMENTS_FOLDER_PATH=/app/local-documents

# Google OAuth (Calendar integration — per-user OAuth flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/auth/google/calendar/callback
FRONTEND_URL=http://localhost:3000

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:5001
VITE_DOCUMENT_COLLECTOR_API_URL=http://localhost:8001
VITE_USER_RCLONE_API_URL=http://localhost:13000
